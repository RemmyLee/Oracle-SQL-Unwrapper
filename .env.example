# PL/SQL Workbench - Environment Configuration
# Copy this file to .env and update with your settings

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True
PORT=3117

# Security Keys (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Database (for app metadata)
DATABASE_URL=sqlite:///plsql_workbench.db
# Production example: postgresql://user:password@localhost:5432/plsql_workbench

# Redis (for caching and Celery - optional in Phase 1)
# REDIS_URL=redis://localhost:6379/0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3117

# Unwrapper Settings
UNWRAP_MAX_INPUT_SIZE=10485760  # 10MB in bytes
UNWRAP_TIMEOUT_SECONDS=30

# Query Execution Settings
QUERY_MAX_RESULT_ROWS=10000
QUERY_TIMEOUT_SECONDS=300

# Logging
LOG_LEVEL=DEBUG
