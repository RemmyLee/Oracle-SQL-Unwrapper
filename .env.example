# PL/SQL Workbench - Environment Configuration
# Copy this file to .env and update with your settings

# ============================================
# Flask Environment
# ============================================
FLASK_ENV=development
FLASK_DEBUG=True
PORT=3117

# ============================================
# Security Keys (CHANGE THESE IN PRODUCTION!)
# ============================================
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# JWT Configuration (Phase 4)
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour in seconds
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 days in seconds

# ============================================
# Database Configuration
# ============================================
# Development (SQLite)
DATABASE_URL=sqlite:///plsql_workbench.db

# Production (PostgreSQL recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/plsql_workbench

# Database Pool Settings (Production)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================
# Redis Configuration (Phase 5)
# ============================================
# Required for caching, rate limiting, and Celery
REDIS_URL=redis://localhost:6379/0

# ============================================
# Email/SMTP Configuration (Phase 4)
# ============================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@plsqlworkbench.com

# ============================================
# CORS Origins
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3117

# ============================================
# Unwrapper Settings
# ============================================
UNWRAP_MAX_INPUT_SIZE=10485760  # 10MB in bytes
UNWRAP_TIMEOUT_SECONDS=30

# ============================================
# Query Execution Settings
# ============================================
QUERY_MAX_RESULT_ROWS=10000
QUERY_TIMEOUT_SECONDS=300

# ============================================
# Dashboard Settings (Phase 5)
# ============================================
DASHBOARD_MAX_COMPONENTS=50
DASHBOARD_MAX_DATA_SOURCES=20
DASHBOARD_CACHE_DEFAULT_TTL=300  # 5 minutes in seconds
DASHBOARD_QUERY_TIMEOUT=30
DASHBOARD_MAX_VERSIONS=50
DASHBOARD_AUTO_VERSION=false  # Auto-create version on publish

# ============================================
# Rate Limiting (Phase 5)
# ============================================
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100 per minute
RATELIMIT_API_STRICT=1000 per hour
RATELIMIT_AUTH=5 per minute
RATELIMIT_PUBLIC=50 per minute

# ============================================
# Security Headers (Production)
# ============================================
FORCE_HTTPS=false  # Set to true in production with HTTPS
SESSION_COOKIE_SECURE=false  # Set to true in production with HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ============================================
# Monitoring & Metrics (Phase 5)
# ============================================
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# ============================================
# Background Tasks (Celery)
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# File Upload Settings
# ============================================
MAX_CONTENT_LENGTH=104857600  # 100MB in bytes
UPLOAD_FOLDER=./uploads

# ============================================
# Logging
# ============================================
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log

# ============================================
# Feature Flags
# ============================================
ENABLE_REGISTRATION=true
ENABLE_API_DOCS=true
ENABLE_METRICS=true
